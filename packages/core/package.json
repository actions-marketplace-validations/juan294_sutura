{
  "name": "@sutura/core",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./recovery-summary": {
      "types": "./src/report/recovery-summary.ts",
      "development": "./src/report/recovery-summary.ts",
      "default": "./dist/report/recovery-summary.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --maxWorkers=1 --testTimeout=60000 --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reportsDirectory=../../coverage/core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "p-limit": "^7.3.2"
  }
}
