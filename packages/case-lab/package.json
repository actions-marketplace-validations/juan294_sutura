{
  "name": "@sutura/case-lab",
  "version": "0.3.1",
  "private": true,
  "description": "Public Sutura Case Lab: server-defined cases, fail-closed dispatcher, deterministic replays, and the signed-out result site.",
  "type": "module",
  "bin": {
    "case-lab": "./bin/case-lab.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sutura/core": "workspace:*",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3"
  }
}
